<div id="<%= dom_id actor %>">
  <p class="mb-1"><strong>Nombre:</strong> <%= actor.nombre %></p>
  <p class="mb-1"><strong>Nacionalidad:</strong> <%= actor.nacionalidad %></p>
  <p class="mb-1"><strong>Fecha de nacimiento:</strong> <%= actor.fecha_nacimiento %></p>
  <p class="mb-0"><strong>Activo:</strong> <%= actor.activo %></p>
</div>
