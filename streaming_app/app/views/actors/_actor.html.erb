<div id="<%= dom_id actor %>">
  <p>
    <strong>Nombre:</strong>
    <%= actor.nombre %>
  </p>

  <p>
    <strong>Nacionalidad:</strong>
    <%= actor.nacionalidad %>
  </p>

  <p>
    <strong>Fecha nacimiento:</strong>
    <%= actor.fecha_nacimiento %>
  </p>

  <p>
    <strong>Activo:</strong>
    <%= actor.activo %>
  </p>

</div>
