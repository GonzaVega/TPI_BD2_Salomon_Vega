<% content_for :title, "Editando actor" %>

<div class="card">
  <div class="card-header">
    <h1 class="h3 mb-0">Editando actor</h1>
  </div>
  <div class="card-body">
    <%= render "form", actor: @actor %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Ver actor", @actor, class: "btn btn-outline-primary" %>
  <%= link_to "Volver a actores", actors_path, class: "btn btn-outline-secondary" %>
</div>
