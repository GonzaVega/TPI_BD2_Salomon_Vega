<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render @actor %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Editar actor", edit_actor_path(@actor), class: "btn btn-primary" %>
  <%= link_to "Volver a actores", actors_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Eliminar actor", @actor, method: :delete, class: "btn btn-danger" %>
</div>
