<% content_for :title, "Editando usuario" %>

<div class="card">
  <div class="card-header">
    <h1 class="h3 mb-0">Editando usuario</h1>
  </div>
  <div class="card-body">
    <%= render "form", usuario: @usuario %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Ver usuario", @usuario, class: "btn btn-outline-primary" %>
  <%= link_to "Volver a usuarios", usuarios_path, class: "btn btn-outline-secondary" %>
</div>
