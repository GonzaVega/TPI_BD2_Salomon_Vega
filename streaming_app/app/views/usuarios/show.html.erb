<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render @usuario %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Editar usuario", edit_usuario_path(@usuario), class: "btn btn-primary" %>
  <%= link_to "Volver a usuarios", usuarios_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Eliminar usuario", @usuario, method: :delete, class: "btn btn-danger" %>
</div>
