<%= form_with(model: usuario, class: "container mt-4") do |form| %>
  <% if usuario.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(usuario.errors.count, "error") %> impidieron guardar este usuario:</h5>
      <ul class="mb-0">
        <% usuario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nombre, class: "form-label" %>
    <%= form.text_field :nombre, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, class: "form-label" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :plan_suscripcion, "Plan de suscripción", class: "form-label" %>
    <%= form.select :plan_suscripcion, ["Básico", "Plus", "Premium"], { include_blank: "Seleccioná un plan" }, class: "form-select" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :activo, class: "form-check-input" %>
    <%= form.label :activo, "Activo", class: "form-check-label" %>
  </div>

  <hr>
  <h5>Perfiles</h5>
  <p class="text-muted small">Cada usuario debe tener entre 1 y 5 perfiles.</p>

  <%= form.fields_for :perfiles do |perfil_form| %>
    <div class="card mb-3 p-3">
      <div class="row">
        <div class="col-md-2 mb-2">
          <%= perfil_form.label :perfil_id, "ID", class: "form-label" %>
          <%= perfil_form.number_field :perfil_id, class: "form-control" %>
        </div>
        <div class="col-md-4 mb-2">
          <%= perfil_form.label :nombre_perfil, "Nombre", class: "form-label" %>
          <%= perfil_form.text_field :nombre_perfil, class: "form-control" %>
        </div>
        <div class="col-md-3 mb-2">
          <%= perfil_form.label :idioma, class: "form-label" %>
          <%= perfil_form.text_field :idioma, class: "form-control", placeholder: "Ej: es-419" %>
        </div>
        <div class="col-md-3 mb-2 d-flex align-items-end">
          <div class="form-check">
            <%= perfil_form.check_box :es_kids, class: "form-check-input" %>
            <%= perfil_form.label :es_kids, "Es perfil infantil", class: "form-check-label" %>
          </div>
        </div>
      </div>

      <% if perfil_form.object.persisted? %>
        <div class="form-check">
          <%= perfil_form.check_box :_destroy, class: "form-check-input" %>
          <%= perfil_form.label :_destroy, "Eliminar este perfil", class: "form-check-label text-danger" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>