<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render @catalogo %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Editar contenido", edit_catalogo_path(@catalogo), class: "btn btn-primary" %>
  <%= link_to "Volver al catálogo", catalogos_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Eliminar contenido", @catalogo, method: :delete, class: "btn btn-danger" %>
</div>
