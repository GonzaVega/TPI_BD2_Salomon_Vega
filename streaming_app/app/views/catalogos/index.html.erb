<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<% content_for :title, "Contenido" %>

<h1 class="mb-4">Contenido</h1>

<div id="catalogos" class="row">
  <% @catalogos.each do |catalogo| %>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <%= render catalogo %>
          <%= link_to "Ver contenido", catalogo, class: "btn btn-sm btn-outline-primary mt-auto align-self-start" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "Nuevo contenido", new_catalogo_path, class: "btn btn-primary" %>
