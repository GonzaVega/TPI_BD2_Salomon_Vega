<% content_for :title, "Editando contenido" %>

<div class="card">
  <div class="card-header">
    <h1 class="h3 mb-0">Editando contenido</h1>
  </div>
  <div class="card-body">
    <%= render "form", catalogo: @catalogo %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Ver contenido", @catalogo, class: "btn btn-outline-primary" %>
  <%= link_to "Volver al catálogo", catalogos_path, class: "btn btn-outline-secondary" %>
</div>
