<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<% content_for :title, "Historial de Reproducción" %>

<h1 class="mb-4">Historial de Reproducción</h1>

<div id="historial_reproduccions" class="row">
  <% @historial_reproduccions.each do |historial| %>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <%= render historial %>
          <%= link_to "Ver registro", historial, class: "btn btn-sm btn-outline-primary mt-auto align-self-start" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "Nuevo registro", new_historial_reproduccion_path, class: "btn btn-primary" %>
