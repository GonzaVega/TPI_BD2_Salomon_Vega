<% if notice %>
  <div class="alert alert-info"><%= notice %></div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render @historial_reproduccion %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Editar registro", edit_historial_reproduccion_path(@historial_reproduccion), class: "btn btn-primary" %>
  <%= link_to "Volver al historial", historial_reproduccions_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Eliminar registro", @historial_reproduccion, method: :delete, class: "btn btn-danger" %>
</div>
