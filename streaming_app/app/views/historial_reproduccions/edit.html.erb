<% content_for :title, "Editando registro" %>

<div class="card">
  <div class="card-header">
    <h1 class="h3 mb-0">Editando registro</h1>
  </div>
  <div class="card-body">
    <%= render "form", historial_reproduccion: @historial_reproduccion %>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <%= link_to "Ver registro", @historial_reproduccion, class: "btn btn-outline-primary" %>
  <%= link_to "Volver al historial", historial_reproduccions_path, class: "btn btn-outline-secondary" %>
</div>
