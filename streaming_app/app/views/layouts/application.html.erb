<!DOCTYPE html>
<html data-bs-theme="dark">
  <head>
    <title><%= content_for(:title) || "Streaming App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>
  <body class="pt-5">
    <nav class="navbar navbar-expand navbar-dark bg-dark fixed-top">
      <div class="container">
        <%= link_to "Streaming App", root_path, class: "navbar-brand" %>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><%= link_to "Inicio", root_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Usuarios", usuarios_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Actores", actors_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Catálogo", catalogos_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Historial", historial_reproduccions_path, class: "nav-link" %></li>
        </ul>
      </div>
    </nav>
    <main class="container mt-4">
      <%= yield %>
    </main>
  </body>
</html>